# === LAVAGNA '26 — configurazione backend ===
# Copia questo file in `.env` e inserisci le tue chiavi.
# Solo ODDS_API_KEY è davvero necessaria per i voti di valore.

# The Odds API — quote reali in tempo reale (necessaria per i voti)
# Chiave gratuita: https://the-odds-api.com
ODDS_API_KEY=

# football-data.org — classifiche ufficiali dei gironi (OPZIONALE)
# Senza chiave, la card "contesto girone" resta semplicemente nascosta.
# Registrazione: https://www.football-data.org/client/register
FOOTBALL_DATA_KEY=

# Anthropic — note qualitative AI (OPZIONALE, a pagamento)
# Il motore voti è deterministico e NON dipende da questa chiave.
# https://console.anthropic.com
ANTHROPIC_API_KEY=

# Porta del backend (default 3001)
PORT=3001
