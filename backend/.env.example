# ——— Chiavi API LAVAGNA '26 PRO (esempio) ———
# Copia questo file in .env e inserisci le tue chiavi.

# The Odds API — quote reali. Chiave gratuita su https://the-odds-api.com
ODDS_API_KEY=

# API-Football — statistiche/formazioni/infortuni. Chiave su https://www.api-football.com
# (usiamo l'endpoint diretto https://v3.football.api-sports.io con header x-apisports-key)
API_FOOTBALL_KEY=

# Anthropic — OPZIONALE: solo note tattiche e sintesi testuali, MAI dati numerici.
ANTHROPIC_API_KEY=

# Porta del backend (il frontend Vite fa proxy qui)
PORT=3001
